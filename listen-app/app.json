{
  "expo": {
    "name": "LISTEN",
    "slug": "listen",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "listen",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E17",
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#0A0E17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.listen.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.listen.app.signal-processing"
        ]
      }
    },
    "android": {
      "package": "com.listen.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E17"
      },
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#06D6A0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "exposdk:51.0.0",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3db7855d-6039-4800-b530-84b4611fbbf4"
      }
    },
    "owner": "jelubrlu",
    "updates": {
      "url": "https://u.expo.dev/3db7855d-6039-4800-b530-84b4611fbbf4"
    }
  }
}
